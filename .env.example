APP_NAME="S3 Lite"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost/s3/public
APP_TIMEZONE=UTC
FORCE_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=s3lite
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=s3lite:

STORAGE_DRIVER=local
STORAGE_ROOT=
MAX_UPLOAD_SIZE=5368709120
CHUNK_SIZE=8388608

JWT_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600
JWT_ISSUER=s3lite

# Lets public/cron.php be triggered over HTTP, for hosts without real cron.
# Leave empty to allow command-line runs only.
CRON_TOKEN=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API=600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_UPLOAD=300

DEFAULT_QUOTA=10737418240
TRASH_RETENTION_DAYS=30
VERSIONS_KEPT=10

VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_COMMAND=

SFTP_ENABLED=true
SFTP_HOST=127.0.0.1
SFTP_PORT=2222
FTP_ENABLED=false
FTP_PORT=21
FTPS_ENABLED=false
FTP_PASSIVE_MIN=50000
FTP_PASSIVE_MAX=50100

# smtp | sendmail | log | none
MAIL_DRIVER=none
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=
MAIL_ALLOW_SELF_SIGNED=false

LOG_LEVEL=debug
